{
  "name": "obgynvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ObGynVault: India-first ObGyn clinical knowledge and guideline reference PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "SINGLE_FILE=true VITE_HASH_ROUTER=true vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.2.7"
  }
}
