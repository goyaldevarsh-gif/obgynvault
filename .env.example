# Phase 2 (Firebase). Optional: leave empty to run fully on-device.
# Firebase console → Project settings → Your apps → Web app → config. These are public values;
# access is protected by firestore.rules (paste it into Firestore → Rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: sub-path for hosting, e.g. /obgynvault/
BASE_PATH=/
